# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF123456-abc123ABC_abc
# Your Telegram user id (comma-separated for several)
ADMIN_ID=your_telegram_id
# Database. Default: local file course_bot.db (no server needed).
# At hosting time just replace it with your MongoDB Atlas URI:
# DATABASE_URL=mongodb+srv://user:pass@cluster0.mongodb.net/course_bot
DATABASE_URL=sqlite:///course_bot.db
